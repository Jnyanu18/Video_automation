{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react"],
    "baseUrl": ".",
    "paths": {"@film": ["examples/sample-film"], "@kit/*": ["src/kit/*"]}
  },
  "include": ["src", "examples"]
}
