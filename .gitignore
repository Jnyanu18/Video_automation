# --- build & caches ---
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
dist/
!automation/web/dist/
.cache/

# --- secrets ---
.env
.env.local
*.key

# --- large media: covered by .restructure manifests + move logs, not by git ---
*.mp4
*.mov
*.webm
*.avi
*.wav
*.mp3
*.m4a

# --- vendor clones with their own upstreams (live in J:\_vendor) ---
agentic-video-editor/

# --- machine state ---
Thumbs.db
.DS_Store

# motion-api job workspaces (each holds a copied kit + renders)
apps/motion-api/.jobs/
packages/motion-kit/out/
packages/motion-kit/.bundle/

# local-only
automation/editor/services/api/.data/
final_push.log
push_output.txt

# Creative-director job queue: client briefs, account ids, downloaded client images and renders (runtime data, never in git)
automation/editor/work/agent_queue/
# local engine / gateway logs
automation/editor/work/*.log

# --- excluded from the render-deploy-clean push (backups, copies, scratch) ---
work/
.codex-motion-build/
.tmp/
.backup/
automation/app-deps-backup-*/
automation/app-deps-partial-*/
automation/app/node_modules.temp-link-*/
