# Dashboard backend (server/index.cjs). Placeholders only; never commit real values.
PORT=8787
HOST=127.0.0.1

# Sign-in. Generate the hash with: npm run hash-password -- "your password"
DASHBOARD_PASSWORD_HASH=
# DASHBOARD_PASSWORD=   # plain text, development only (refused when NODE_ENV=production)
SESSION_SECRET=         # 32+ random characters; sessions end when it changes
SESSION_HOURS=12
# Secure cookie flag defaults to true when PUBLIC_BASE_URL is https
# COOKIE_SECURE=true
# Set to true only behind a reverse proxy you control (uses X-Forwarded-For for login throttling)
# TRUST_PROXY=true
NODE_ENV=production

# n8n webhooks (same values as the three "Reels ... Webhook Auth" credentials in n8n)
N8N_WEBHOOK_BASE=https://your-n8n.example.com
N8N_INTAKE_TOKEN=
N8N_APPROVAL_TOKEN=
N8N_INTERNAL_TOKEN=
# N8N_TIMEOUT_MS=45000

# Read-only Airtable token (data.records:read on this base only). Writes only ever happen inside n8n.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Reels
AIRTABLE_READ_TOKEN=
# HISTORY_MAX_RECORDS=2000

# Public https origin of this server. Required for video upload: Blotato downloads uploaded files from here.
PUBLIC_BASE_URL=https://reels.example.com
# UPLOAD_DIR=./server/storage
MAX_UPLOAD_MB=100

# Built frontend (served with an SPA fallback)
# WEB_DIR=./web/dist

# Live updates: Airtable is polled by the server only while a dashboard is open
# LIVE_POLL_ACTIVE_MS=5000
# LIVE_POLL_IDLE_MS=20000
# RECORD_CACHE_MS=4000
