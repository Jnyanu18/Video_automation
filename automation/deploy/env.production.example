# Copy to deploy/.env on the server and fill in. Never commit the filled copy.
#   cp deploy/env.production.example deploy/.env
#
# deploy/.env is in .dockerignore and must be in .gitignore: it holds real secrets.

# ---- hostname and TLS ----------------------------------------------------------
# The public hostname Caddy gets a Let's Encrypt certificate for. A free DuckDNS
# subdomain works. An IP address will NOT work -- certificates are not issued for IPs,
# and without a certificate the Secure session cookie is dropped and sign-in fails.
SITE_HOST=yourapp.duckdns.org

# Must match SITE_HOST exactly, with the scheme. Used for upload URLs handed to
# external services, so a wrong value breaks publishing, not just links.
PUBLIC_BASE_URL=https://yourapp.duckdns.org

# ---- sessions and sign-in ------------------------------------------------------
NODE_ENV=production
# 32+ random characters. Changing it signs everyone out. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=true
TRUST_PROXY=true

# Pilot accounts live in the app_data volume, created after the stack is up:
#   docker compose -f deploy/docker-compose.yml exec dashboard \
#     node server/create-user.cjs "client@example.com" "<password, 10+ chars>"
# DASHBOARD_PASSWORD_HASH is only the single-operator fallback; leave empty when
# using real accounts. DASHBOARD_PASSWORD (plaintext) is refused in production.
DASHBOARD_PASSWORD_HASH=

# ---- uploads -------------------------------------------------------------------
# Caddy refuses bodies over 250MB; this is the app-level limit clients actually hit.
MAX_UPLOAD_MB=100

# ---- the model ------------------------------------------------------------------
# gemini | anthropic | openrouter | ollama | custom
EDITOR_LLM=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- resource limits -----------------------------------------------------------
# Oracle Ampere A1 always-free is 4 OCPU / 24 GB. Leave headroom for Caddy and Node.
ENGINE_CPUS=3.0
ENGINE_MEM=12g

# ---- optional ------------------------------------------------------------------
# The agentic-video-editor checkout, if you vendor it in. Unset means the AVE
# features report unavailable, which is handled and not an error.
EDITOR_AVE_ROOT=

# Publishing connectors. Leave empty and the features stay on STANDBY rather than
# failing: do not advertise publishing to clients until these are real.
N8N_WEBHOOK_BASE=
N8N_INTAKE_TOKEN=
N8N_APPROVAL_TOKEN=
N8N_INTERNAL_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
AIRTABLE_READ_TOKEN=
