# Postiz adapter (adapters/postiz/index.cjs). Placeholders only.
# Self-hosted Postiz: http://localhost:5000/api/public/v1 (or https://<your-domain>/api/public/v1). Cloud: https://api.postiz.com/public/v1
POSTIZ_API_URL=
# Postiz > Settings > Public API
POSTIZ_API_KEY=
ADAPTER_PORT=8790
# Must equal the value of the "Blotato API Key" credential in n8n (header Authorization)
ADAPTER_TOKEN=
# Postiz limits GET /posts to 30 requests/hour; status polls are cached for this long
POSTIZ_STATUS_CACHE_SECONDS=60
MAX_UPLOAD_MB=100
