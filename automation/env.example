# Copy into your n8n environment. Placeholders only; never commit real values.
N8N_WEBHOOK_BASE=https://your-n8n.example.com
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Reels
# AIRTABLE_BASE_URL=https://api.airtable.com

# APIFY_BASE_URL=https://api.apify.com
# LLM and speech-to-text: any OpenAI-compatible endpoint (the credential named "OpenAI API" holds its key).
#   OpenAI: leave OPENAI_BASE_URL unset, LLM_JSON_MODE=json_schema
#   Groq (free tier): OPENAI_BASE_URL=https://api.groq.com/openai  OPENAI_MODEL=openai/gpt-oss-120b  OPENAI_STT_MODEL=whisper-large-v3-turbo  LLM_JSON_MODE=json_schema
#   Ollama (local): OPENAI_BASE_URL=http://127.0.0.1:11434  OPENAI_MODEL=<a pulled model>  LLM_JSON_MODE=json_object  (no speech-to-text)
#   Claude: OPENAI_BASE_URL=https://api.anthropic.com  OPENAI_MODEL=claude-sonnet-5-5  LLM_JSON_MODE=none  (no speech-to-text)
# OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
# json_schema (strict, OpenAI) | json_object | none. Output is validated and retried in code in every mode.
LLM_JSON_MODE=json_schema

# Optional Slack-compatible incoming webhook for ready/failed notifications
NOTIFY_WEBHOOK_URL=

# Tuning (defaults shown)
TARGET_SECONDS=30
WORDS_PER_SECOND=2.5
MAX_SOURCE_SECONDS=180
MAX_CONTENT_ATTEMPTS=3
MAX_SCRIPT_OVERLAP=0.2
MAX_CAPTION_OVERLAP=0.4
LOCK_TTL_MINUTES=30

# HeyGen (video generation, workflow 04)
# HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_RESOLUTION=1080p
HEYGEN_POLL_SECONDS=10
HEYGEN_POLL_CAP_SECONDS=60
MAX_POLL_ATTEMPTS=40
MIN_VIDEO_SECONDS=3
MAX_VIDEO_SECONDS=90
MAX_VIDEO_ATTEMPTS=3

# Publishing (workflow 05). Publishing after video generation is opt-in.
AUTO_PUBLISH=false
# mock = Blotato-compatible mock (no cost); blotato = real Blotato API (paid subscription and your own API key);
# postiz = local adapter in adapters/postiz in front of Postiz (self-hosted is free)
PUBLISH_ADAPTER=mock
# postiz adapter only (the "Blotato API Key" credential then holds ADAPTER_TOKEN, header name Authorization)
# POSTIZ_ADAPTER_URL=http://127.0.0.1:8790
# POSTIZ_INTEGRATION_ID=
# Set to false when HeyGen is not used (uploaded videos only); Settings then shows HeyGen as disabled
# HEYGEN_ENABLED=false
# mock adapter only; must not be a blotato host
MOCK_PUBLISH_BASE_URL=http://localhost:4010
# blotato adapter only. The base URL is pinned to https://backend.blotato.com; leave unset.
# BLOTATO_BASE_URL=https://backend.blotato.com
# Connected Instagram account id from Blotato (the mock adapter defaults to acc_mock_1)
BLOTATO_ACCOUNT_ID=
# Hosts accepted for Blotato-hosted media URLs (verify against a real upload response before going live)
# BLOTATO_MEDIA_HOSTS=blotato.com,blotato.io
PUBLISH_POLL_SECONDS=5
PUBLISH_POLL_CAP_SECONDS=60
MAX_PUBLISH_POLL_ATTEMPTS=30
MAX_POST_CREATE_ATTEMPTS=3
POST_CREATE_RETRY_SECONDS=5

# Approval (workflow 03)
MAX_REGENERATIONS=5
APPROVAL_LOCK_MINUTES=2
MIN_EDIT_WORDS=10

# Uploaded videos (workflow 06; keep equal to the backend's MAX_UPLOAD_MB)
MAX_UPLOAD_MB=100
